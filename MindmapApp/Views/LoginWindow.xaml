<Window x:Class="MindmapApp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MindmapApp - Đăng nhập"
        WindowStartupLocation="CenterScreen"
        Height="560"
        Width="920"
        Background="Transparent"
        AllowsTransparency="True"
        ResizeMode="CanMinimize"
        WindowStyle="None"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEE"/>
                    <Setter Property="Foreground" Value="#333"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Effect>
            <DropShadowEffect BlurRadius="40" Opacity="0.25" ShadowDepth="0" />
        </Grid.Effect>

        <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="26" Padding="32">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="103*"/>
                    <RowDefinition Height="21*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2.2*" />
                </Grid.ColumnDefinitions>

                <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="20" Margin="0,0,28,0" Padding="36" Grid.RowSpan="2">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" Opacity="0.15" ShadowDepth="0" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                            <Ellipse Width="12" Height="12" Fill="#FF9AD1FF" Margin="0,0,10,0"/>
                            <Ellipse Width="12" Height="12" Fill="#FFFCE38A" Margin="0,0,10,0"/>
                            <Ellipse Width="12" Height="12" Fill="#FF89F7FE" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" VerticalAlignment="Top" >
                            <TextBlock Foreground="White" FontSize="35" FontWeight="Bold" Margin="0,0,0,6" TextAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Mind Map App"></Setter>
                                        <Style.Triggers>
                                            <EventTrigger RoutedEvent="Window.Loaded">
                                                <BeginStoryboard Storyboard="{StaticResource ThuanStoryBoard}"></BeginStoryboard>
                                            </EventTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Border Width="300" Height="220" CornerRadius="25" Margin="0,0,0,0" HorizontalAlignment="Center">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.2"/>
                                </Border.Effect>
                                <Border.Background>
                                    <ImageBrush ImageSource="/Resources/LoginMindMap.jpg" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>

                            <TextBlock Text="Created by Dev không Bugs" Foreground="White" FontSize="14" Opacity="0.8" HorizontalAlignment="Center" Margin="0,10,0,0" FontStyle="Italic"/>
                        </StackPanel>

                        <Grid Grid.Column="0" Grid.ColumnSpan="2" Height="40" VerticalAlignment="Top" MouseLeftButtonDown="Grid_MouseLeftButtonDown">
                            <Border CornerRadius="26,26,0,0" ToolTip="Giữ chuột trái để di chuyển" Background="#01000000" Cursor="SizeAll"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,-10,0">
                                <Button Content="&#xE921;" Style="{StaticResource WindowButtonStyle}" Click="Button_Click" Cursor="Hand" ToolTip="Thu nhỏ"/>
                                <Button Content="&#xE8BB;" Style="{StaticResource CloseButtonStyle}" Click="Button_Click_1" Cursor="Hand" ToolTip="Đóng"/>
                                <Border Width="20"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="24" Padding="40,36" Grid.RowSpan="2">
                    <StackPanel>
                        <TextBlock Text="Chào mừng trở lại 👋" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="Đăng nhập để quản lý mindmap của bạn" Margin="0,6,0,24" Foreground="{DynamicResource TextBrush}" Opacity="0.7"/>

                        <StackPanel>
                            <TextBlock Text="Email" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" 
                                     Height="36" Padding="4,6" FontSize="14" 
                                     BorderThickness="1"
                                     Background="{DynamicResource BackgroundBrush}"
                                     Foreground="{DynamicResource TextBrush}"
                                     BorderBrush="{DynamicResource TextBrush}"
                                     CaretBrush="{DynamicResource TextBrush}"/>
                        </StackPanel>

                        <StackPanel Margin="0,14,0,0">
                            <TextBlock Text="Mật khẩu" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>

                            <Grid Margin="0,8,0,0">
                                <PasswordBox x:Name="PasswordBox" 
                                         Height="36" Padding="4,6,35,6" FontSize="14" 
                                         BorderThickness="1"
                                         Background="{DynamicResource BackgroundBrush}"
                                         Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource TextBrush}"
                                         CaretBrush="{DynamicResource TextBrush}"/>

                                <TextBox x:Name="VisiblePasswordBox"
                                         Visibility="Collapsed"
                                         Height="36" Padding="4,6,35,6" FontSize="14" 
                                         BorderThickness="1"
                                         Background="{DynamicResource BackgroundBrush}"
                                         Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource TextBrush}"
                                         CaretBrush="{DynamicResource TextBrush}"/>

                                <ToggleButton Style="{StaticResource EyeToggleButtonStyle}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" 
                                              Margin="0,8,5,0"
                                              Checked="ShowPassword_Checked" Unchecked="ShowPassword_Unchecked"/>
                            </Grid>
                        </StackPanel>

                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFEF5350" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="13"/>

                        <Button x:Name="LoginButton" Content="Đăng nhập" Margin="0,20,0,0" Click="LoginButton_OnClick" 
                                Height="36" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                                Background="{DynamicResource PrimaryBrush}" Foreground="White"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <TextBlock Text="Quên mật khẩu?" Foreground="{DynamicResource TextBrush}" Opacity="0.7" Margin="0,0,6,0" />
                            <Button Content="Gửi OTP" Background="Transparent" Foreground="{DynamicResource PrimaryBrush}" BorderThickness="0" Click="ForgotButton_OnClick" FontWeight="SemiBold" Padding="4,0"/>
                        </StackPanel>

                        <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="16" Padding="16" Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                                <TextBlock Text="Chưa có tài khoản?" Margin="0,0,4,0" Foreground="{DynamicResource TextBrush}"/>
                                <Button Content="Đăng ký ngay" Background="Transparent" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" BorderThickness="0" Click="RegisterButton_OnClick" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>