<Window x:Class="MindmapApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MindmapApp.ViewModels"
        xmlns:conv="clr-namespace:MindmapApp.Converters"
        xmlns:helpers="clr-namespace:MindmapApp.Helpers" 
        xmlns:anim="clr-namespace:MindmapApp.Helpers" 
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:views="clr-namespace:MindmapApp.Views"
        mc:Ignorable="d"
        Title="MindmapApp"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ResizeMode="CanMinimize"
        Background="{DynamicResource BackgroundBrush}"
        WindowStyle="None"
        UseLayoutRounding="True">

    <Window.Resources>
        <DataTemplate x:Key="ShapeIconTemplate">
            <Grid Width="30" Height="30" ToolTip="{Binding}">
                <Border Background="Transparent"/>
                <Path x:Name="ShapePath" Stretch="Uniform" Stroke="White" StrokeThickness="2" Fill="Transparent" Margin="4"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="Rectangle">
                    <Setter TargetName="ShapePath" Property="Data" Value="M 0,0 L 1,0 L 1,1 L 0,1 Z"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="RoundedRectangle">
                    <Setter TargetName="ShapePath" Property="Data" Value="M 0.2,0 L 0.8,0 A 0.2,0.2 90 0 1 1,0.2 L 1,0.8 A 0.2,0.2 90 0 1 0.8,1 L 0.2,1 A 0.2,0.2 90 0 1 0,0.8 L 0,0.2 A 0.2,0.2 90 0 1 0.2,0 Z"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="Ellipse">
                    <Setter TargetName="ShapePath" Property="Data" Value="M 0.5,0 A 0.5,0.5 0 1 1 0.5,1 A 0.5,0.5 0 1 1 0.5,0 Z"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="Diamond">
                    <Setter TargetName="ShapePath" Property="Data" Value="M 0.5,0 L 1,0.5 L 0.5,1 L 0,0.5 Z"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="Parallelogram">
                    <Setter TargetName="ShapePath" Property="Data" Value="M 0.2,0 L 1,0 L 0.8,1 L 0,1 Z"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="Hexagon">
                    <Setter TargetName="ShapePath" Property="Data" Value="M 0.2,0 L 0.8,0 L 1,0.5 L 0.8,1 L 0.2,1 L 0,0.5 Z"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <SolidColorBrush x:Key="AccentBrush" Color="#007ACC"/>
        <DropShadowEffect x:Key="SelectionGlow" Color="#007ACC" BlurRadius="20" ShadowDepth="0" Opacity="0.8"/>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="22" ShadowDepth="0" Opacity="0.18" />
        <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#102033" Offset="0" />
            <GradientStop Color="#0C1828" Offset="1" />
        </LinearGradientBrush>

        <DrawingBrush x:Key="NodeGridLightBrush" Viewport="0,0,10,10" ViewportUnits="Absolute" TileMode="Tile">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#90FFFFFF" Thickness="0.3" />
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="0,0" EndPoint="10,0" />
                                <LineGeometry StartPoint="0,0" EndPoint="0,10" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <DrawingBrush x:Key="NodeGridDenseBrush" Viewport="0,0,6,6" ViewportUnits="Absolute" TileMode="Tile">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#D0FFFFFF" Thickness="0.5" />
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="0,0" EndPoint="6,0" />
                                <LineGeometry StartPoint="0,0" EndPoint="0,6" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <conv:ColorToBrushConverter x:Key="ColorToBrushConverter" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <conv:ConnectionToGeometryConverter x:Key="ConnectionToGeometryConverter" />
        <conv:ConnectionToArrowGeometryConverter x:Key="ConnectionToArrowGeometryConverter" />
        <conv:BoolToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Storyboard x:Key="HideSidebar">
            <anim:GridLengthAnimation Storyboard.TargetName="LeftColumn" Storyboard.TargetProperty="Width" To="0" Duration="0:0:0.2" />
        </Storyboard>
        <Storyboard x:Key="ShowSidebar">
            <anim:GridLengthAnimation Storyboard.TargetName="LeftColumn" Storyboard.TargetProperty="Width" To="350" Duration="0:0:0.2" />
        </Storyboard>
        <Storyboard x:Key="CollapseRight">
            <anim:GridLengthAnimation Storyboard.TargetName="RightColumn" Storyboard.TargetProperty="Width" To="0" Duration="0:0:0.2" />
        </Storyboard>
        <Storyboard x:Key="ExpandRight">
            <anim:GridLengthAnimation Storyboard.TargetName="RightColumn" Storyboard.TargetProperty="Width" To="320" Duration="0:0:0.2" />
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.15" />
        </Grid.Effect>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" HorizontalAlignment="Stretch" LastChildFill="False" Background="{DynamicResource PrimaryBrush}" Height="25"
                   Visibility="{Binding IsPresentationMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
            <Image DockPanel.Dock="Right" Source="/Resources/x.png" PreviewMouseDown="Image_PreviewMouseDown" Cursor="Hand" Margin="10,0,20,0" Width="15"/>
            <Image DockPanel.Dock="Right" Source="/Resources/-.png" PreviewMouseDown="Image_PreviewMouseDown_1" Cursor="Hand" Margin="0,0,15,0" Width="15"/>
        </DockPanel>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="28"/>
                    <Setter Property="Padding" Value="18"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPresentationMode}" Value="True">
                            <Setter Property="CornerRadius" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" x:Name="HeaderRowTop" />
                    <RowDefinition Height="Auto" x:Name="HeaderRowToolbar" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,10" x:Name="HeaderContentGrid"
                      Visibility="{Binding IsPresentationMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Fill="#FF9AD1FF" Margin="0,0,10,0" />
                            <Ellipse Width="10" Height="10" Fill="#FFFCE38A" Margin="0,0,10,0" />
                            <Ellipse Width="10" Height="10" Fill="#FF89F7FE" />
                        </StackPanel>
                        <TextBlock Text="Mind Map App" Foreground="Blue" FontSize="20" FontWeight="Bold" Margin="0,5,0,0"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,5,0,0">
                            <TextBlock Text="Project:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#666"/>
                            <TextBox Width="200" Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="#CCC" Foreground="{DynamicResource TextBrush}" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Margin="10,0,0,0" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="20" BorderBrush="#DDD" BorderThickness="1" Height="40" Margin="0,0,15,0">
                            <Grid Width="220">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" TextChanged="SearchBox_TextChanged" Margin="0" Padding="15,0" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0"/>
                                    <TextBlock x:Name="Placeholder" Text="Tìm kiếm node..." Foreground="#FF9AA9BC" Margin="15,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                                </Grid>
                                <Button Grid.Column="1" Content="🔍" Command="{Binding SearchCommand}" Width="40" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="{DynamicResource AccentBrush}"/>
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource ToolbarButton}" ToolTip="Bắt đầu trình chiếu" 
                                    Command="{Binding StartPresentationCommand}" 
                                    Height="40" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📺" Margin="0,0,5,0"/>
                                    <TextBlock Text="Trình chiếu"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolbarButton}" Click="BtnExportImage_Click" Height="40" Margin="0,0,10,0" ToolTip="Xuất ảnh">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📷" Margin="0,0,5,0"/>
                                    <TextBlock Text="Ảnh"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolbarButton}" Click="BtnExportPdf_Click" Height="40" Margin="0,0,15,0" ToolTip="Xuất PDF">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📄" Margin="0,0,5,0"/>
                                    <TextBlock Text="PDF"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="{DynamicResource BackgroundBrush}" CornerRadius="16" Margin="0,0,0,0" Padding="5" x:Name="HeaderToolbarBorder"
                        Visibility="{Binding IsPresentationMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                <Border Background="#10000000" CornerRadius="8" Padding="5" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding UndoCommand}" Content="↩" MinWidth="50" ToolTip="Hoàn tác (Undo)"/>
                                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding RedoCommand}" Content="↪" MinWidth="50" ToolTip="Làm lại (Redo)"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#10000000" CornerRadius="8" Padding="5" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding AddNodeCommand}" Content="➕ Thêm Node" MinWidth="100" FontWeight="SemiBold"/>
                                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding AddChildNodeCommand}" Content="🌱 Nhánh con" MinWidth="100"/>
                                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding DeleteNodeCommand}" Content="❌ Xóa" MinWidth="80" Foreground="#D32F2F"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#10000000" CornerRadius="8" Padding="5" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource ToolbarButton}" Click="StartConnectionButton_OnClick" Content="🔗 Nối dây" MinWidth="90"/>
                                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding ClearConnectionCommand}" Content="✂️ Hủy" MinWidth="70"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#10000000" CornerRadius="8" Padding="5" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding ZoomInCommand}" Content="🔍 +" MinWidth="60"/>
                                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding ZoomOutCommand}" Content="🔍 -" MinWidth="60"/>
                                    </StackPanel>
                                </Border>
                                <Button Style="{StaticResource ToolbarButton}" Command="{Binding ToggleThemeCommand}" Content="🌗 Theme" MinWidth="80" Margin="0,0,5,0"/>
                                <Button Style="{StaticResource ToolbarButton}" Command="{Binding OpenProfileCommand}" Content="👤 Tài khoản" MinWidth="90" Background="#334455" BorderBrush="#556677" Foreground="White" Margin="0,0,5,0"/>
                                <Button Style="{StaticResource ToolbarButton}" Command="{Binding ClearAllCommand}" Content="🗑️ Xóa tất cả" MinWidth="100" Background="#FFEF9A9A" Foreground="#B71C1C" BorderBrush="#FFEF5350" Margin="0,0,5,0"/>
                                <Button Style="{StaticResource ToolbarButton}" Click="BtnRecent_Click" Content="Recent" MinWidth="80" Background="#FF90CAF9" Foreground="#0D47A1" BorderBrush="#FF42A5F5" ToolTip="Quay lại danh sách"/>
                            </StackPanel>
                        </ScrollViewer>
                        <ToggleButton Grid.Column="1" x:Name="BtnToggleRight" Click="BtnToggleRight_Click" IsChecked="True" Cursor="Hand" Margin="10,0,5,0" Height="35" Background="Transparent" BorderThickness="0">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="#1AFFFFFF" CornerRadius="8" Padding="12,0" BorderBrush="#33FFFFFF" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Định dạng" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock x:Name="ArrowIcon" Text="▶" Foreground="#4DD0E1" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="ArrowIcon" Property="Text" Value="▶" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="False">
                                            <Setter TargetName="ArrowIcon" Property="Text" Value="◀" />
                                            <Setter TargetName="ArrowIcon" Property="Foreground" Value="Gray" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" VerticalAlignment="Top" HorizontalAlignment="Center" Width="200" Height="40" Margin="0,-1,0,0" Panel.ZIndex="1000" Background="Transparent" x:Name="HeaderToggleArea">
                    <Button x:Name="ToggleHeaderButton"
                            Content="▲" 
                            Width="120" Height="34" 
                            VerticalAlignment="Top" HorizontalAlignment="Center"
                            Background="{DynamicResource PrimaryBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="18"
                            Cursor="Hand"
                            Click="ToggleHeader_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Opacity" Value="0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="0,0,12,12"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="5" ShadowDepth="2" Direction="270" Color="#40000000" Opacity="0.3"/>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Resources>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0,0,12,12">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Margin" Value="0,18,0,18"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPresentationMode}" Value="True">
                                    <Setter Property="Margin" Value="0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="LeftColumn" Width="350"/>

                        <ColumnDefinition Width="*" />

                        <ColumnDefinition x:Name="RightColumn" Width="320"/>
                    </Grid.ColumnDefinitions>

                    <views:TextEditorSidebar Grid.Column="0" Width="350"
                        Visibility="{Binding IsPresentationMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>

                    <Button x:Name="ToggleButton" Grid.Column="1" Content="◀" 
                            Visibility="{Binding IsPresentationMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"
                            Width="34" Height="120" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-16,0,0,0" 
                            Padding="0" Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderThickness="0" FontSize="18" Click="ToggleSidebar_Click" Panel.ZIndex="5"/>

                    <Border Grid.Column="1" Background="{DynamicResource BackgroundBrush}" Padding="0" ClipToBounds="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="26"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPresentationMode}" Value="True">
                                        <Setter Property="CornerRadius" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <ScrollViewer x:Name="MainScrollViewer" Background="{DynamicResource GridBackgroundBrush}" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible" PanningMode="None">

                            <Grid x:Name="MindmapWorkspace" Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" Background="Transparent" MouseDown="MindmapWorkspace_MouseDown" MouseMove="MindmapWorkspace_MouseMove" MouseUp="MindmapWorkspace_MouseUp">

                                <Grid.LayoutTransform>
                                    <ScaleTransform ScaleX="{Binding ZoomLevel}" ScaleY="{Binding ZoomLevel}" />
                                </Grid.LayoutTransform>

                                <Border Background="{Binding CanvasBackgroundColor, Converter={StaticResource ColorToBrushConverter}}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False"/>

                                <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False" Opacity="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanvasGridStyle}" Value="Light">
                                                    <Setter Property="Background" Value="{StaticResource NodeGridLightBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CanvasGridStyle}" Value="Dense">
                                                    <Setter Property="Background" Value="{StaticResource NodeGridDenseBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CanvasGridStyle}" Value="None">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <Border BorderBrush="#1A000000" BorderThickness="2" Background="Transparent" Opacity="1" IsHitTestVisible="False"/>

                                <ItemsControl ItemsSource="{Binding Connections}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ConnectionViewModel}">
                                            <Grid>
                                                <Grid.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" 
                                                                  Command="{Binding DataContext.SelectConnectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}"/>
                                                </Grid.InputBindings>

                                                <Path x:Name="HitPath" StrokeThickness="20" Stroke="Transparent" Cursor="Hand">
                                                    <Path.Data>
                                                        <MultiBinding Converter="{StaticResource ConnectionToGeometryConverter}">
                                                            <Binding Path="Source.X" />
                                                            <Binding Path="Source.Y" />
                                                            <Binding Path="Source.Width" />
                                                            <Binding Path="Source.Height" />
                                                            <Binding Path="Target.X" />
                                                            <Binding Path="Target.Y" />
                                                            <Binding Path="Target.Width" />
                                                            <Binding Path="Target.Height" />
                                                            <Binding Path="ConnectionStyle" />
                                                            <Binding Path="ArrowStyle" />
                                                        </MultiBinding>
                                                    </Path.Data>
                                                </Path>

                                                <Path x:Name="SelectionGlowPath" IsHitTestVisible="False" 
                                                      Stroke="#007ACC" StrokeThickness="6" Opacity="0" 
                                                      StrokeEndLineCap="Round" StrokeStartLineCap="Round">
                                                    <Path.Effect>
                                                        <DropShadowEffect Color="#007ACC" BlurRadius="15" ShadowDepth="0" Opacity="1"/>
                                                    </Path.Effect>
                                                    <Path.Data>
                                                        <MultiBinding Converter="{StaticResource ConnectionToGeometryConverter}">
                                                            <Binding Path="Source.X" />
                                                            <Binding Path="Source.Y" />
                                                            <Binding Path="Source.Width" />
                                                            <Binding Path="Source.Height" />
                                                            <Binding Path="Target.X" />
                                                            <Binding Path="Target.Y" />
                                                            <Binding Path="Target.Width" />
                                                            <Binding Path="Target.Height" />
                                                            <Binding Path="ConnectionStyle" />
                                                            <Binding Path="ArrowStyle" />
                                                        </MultiBinding>
                                                    </Path.Data>
                                                </Path>

                                                <Path x:Name="VisualPath" IsHitTestVisible="False" 
                                                      StrokeThickness="{Binding Thickness}" 
                                                      Stroke="{Binding StrokeColor, Converter={StaticResource ColorToBrushConverter}}" 
                                                      StrokeDashArray="{Binding DashArray}" 
                                                      Opacity="0.9" 
                                                      StrokeEndLineCap="Round" 
                                                      StrokeStartLineCap="Round">
                                                    <Path.Data>
                                                        <MultiBinding Converter="{StaticResource ConnectionToGeometryConverter}">
                                                            <Binding Path="Source.X" />
                                                            <Binding Path="Source.Y" />
                                                            <Binding Path="Source.Width" />
                                                            <Binding Path="Source.Height" />
                                                            <Binding Path="Target.X" />
                                                            <Binding Path="Target.Y" />
                                                            <Binding Path="Target.Width" />
                                                            <Binding Path="Target.Height" />
                                                            <Binding Path="ConnectionStyle" />
                                                            <Binding Path="ArrowStyle" />
                                                        </MultiBinding>
                                                    </Path.Data>
                                                </Path>

                                                <Path x:Name="ArrowPath" IsHitTestVisible="False"
                                                      Fill="{Binding StrokeColor, Converter={StaticResource ColorToBrushConverter}}"
                                                      Stroke="{Binding StrokeColor, Converter={StaticResource ColorToBrushConverter}}"
                                                      StrokeThickness="1"
                                                      Opacity="0.9">
                                                    <Path.Data>
                                                        <MultiBinding Converter="{StaticResource ConnectionToArrowGeometryConverter}">
                                                            <Binding Path="Source.X" />
                                                            <Binding Path="Source.Y" />
                                                            <Binding Path="Source.Width" />
                                                            <Binding Path="Source.Height" />
                                                            <Binding Path="Target.X" />
                                                            <Binding Path="Target.Y" />
                                                            <Binding Path="Target.Width" />
                                                            <Binding Path="Target.Height" />
                                                            <Binding Path="ConnectionStyle" />
                                                            <Binding Path="ArrowStyle" />
                                                        </MultiBinding>
                                                    </Path.Data>
                                                </Path>
                                            </Grid>

                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding ArrowStyle}" Value="Arrow">
                                                    <Setter TargetName="ArrowPath" Property="Panel.ZIndex" Value="10" />
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="SelectionGlowPath" Property="Opacity" Value="1" />
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding Source.IsVisible}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Target.IsVisible}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding Nodes}" Canvas.ZIndex="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:NodeViewModel}">
                                            <Grid Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">

                                                <Grid Width="{Binding Width}" Height="{Binding Height}">

                                                    <Thumb Width="{Binding Width}" Height="{Binding Height}" Tag="{Binding}" DragDelta="NodeThumb_OnDragDelta" PreviewMouseLeftButtonDown="Thumb_PreviewMouseLeftButtonDown" DragStarted="Thumb_DragStarted">
                                                        <Thumb.Style>
                                                            <Style TargetType="Thumb">
                                                                <Setter Property="Cursor" Value="Hand"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDraggable}" Value="False">
                                                                        <Setter Property="Cursor" Value="Arrow"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Thumb.Style>
                                                        <Thumb.Template>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <Grid>
                                                                    <Border x:Name="NodeBackground" Background="{Binding BackgroundColor, Converter={StaticResource ColorToBrushConverter}}" CornerRadius="12" BorderThickness="2" BorderBrush="{Binding BorderColor, Converter={StaticResource ColorToBrushConverter}}"/>
                                                                    <Border x:Name="NodeGridBackground" CornerRadius="12" Background="Transparent" />
                                                                    <Path x:Name="CustomShape" Visibility="Collapsed" Stretch="Fill" Fill="{Binding BackgroundColor, Converter={StaticResource ColorToBrushConverter}}" Stroke="{Binding BorderColor, Converter={StaticResource ColorToBrushConverter}}" StrokeThickness="2">
                                                                        <Path.Effect>
                                                                            <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.25" />
                                                                        </Path.Effect>
                                                                    </Path>
                                                                    <RichTextBox IsReadOnly="True" IsHitTestVisible="False" Focusable="False" 
                                                                                 helpers:RichTextBoxHelper.DocumentXaml="{Binding ContentXaml, Mode=OneWay}" 
                                                                                 Background="Transparent" BorderThickness="0" Padding="10" 
                                                                                 HorizontalAlignment="Stretch" VerticalAlignment="Center" 
                                                                                 Width="{Binding Width}" MaxHeight="{Binding Height}"
                                                                                 CaretBrush="{Binding TextColor, Converter={StaticResource ColorToBrushConverter}}">
                                                                        <RichTextBox.Resources>
                                                                            <Style TargetType="{x:Type Paragraph}">
                                                                                <Setter Property="Margin" Value="0"/>
                                                                            </Style>
                                                                            <Style TargetType="{x:Type FlowDocument}">
                                                                                <Setter Property="FontFamily" Value="{Binding FontFamily, FallbackValue=Arial}"/>
                                                                                <Setter Property="FontSize" Value="{Binding FontSize, FallbackValue=14}"/>
                                                                                <Setter Property="Foreground" Value="{Binding TextColor, Converter={StaticResource ColorToBrushConverter}}"/>
                                                                                <Setter Property="PagePadding" Value="0"/>
                                                                            </Style>
                                                                        </RichTextBox.Resources>
                                                                    </RichTextBox>
                                                                </Grid>
                                                                <ControlTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding Shape}" Value="Rectangle">
                                                                        <Setter TargetName="NodeBackground" Property="CornerRadius" Value="0" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Shape}" Value="Ellipse">
                                                                        <Setter TargetName="NodeBackground" Property="CornerRadius" Value="100" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Shape}" Value="Diamond">
                                                                        <Setter TargetName="NodeBackground" Property="Visibility" Value="Collapsed" />
                                                                        <Setter TargetName="CustomShape" Property="Visibility" Value="Visible" />
                                                                        <Setter TargetName="CustomShape" Property="Data" Value="M 0.5,0 L 1,0.5 L 0.5,1 L 0,0.5 Z" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Shape}" Value="Parallelogram">
                                                                        <Setter TargetName="NodeBackground" Property="Visibility" Value="Collapsed" />
                                                                        <Setter TargetName="CustomShape" Property="Visibility" Value="Visible" />
                                                                        <Setter TargetName="CustomShape" Property="Data" Value="M 0.2,0 L 1,0 L 0.8,1 L 0,1 Z" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Shape}" Value="Hexagon">
                                                                        <Setter TargetName="NodeBackground" Property="Visibility" Value="Collapsed" />
                                                                        <Setter TargetName="CustomShape" Property="Visibility" Value="Visible" />
                                                                        <Setter TargetName="CustomShape" Property="Data" Value="M 0.15,0 L 0.85,0 L 1,0.5 L 0.85,1 L 0.15,1 L 0,0.5 Z" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding BackgroundGridStyle}" Value="Light">
                                                                        <Setter TargetName="NodeGridBackground" Property="Background" Value="{StaticResource NodeGridLightBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding BackgroundGridStyle}" Value="Dense">
                                                                        <Setter TargetName="NodeGridBackground" Property="Background" Value="{StaticResource NodeGridDenseBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding BackgroundGridStyle}" Value="None">
                                                                        <Setter TargetName="NodeGridBackground" Property="Background" Value="Transparent" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter TargetName="NodeBackground" Property="BorderBrush" Value="#007ACC" />
                                                                        <Setter TargetName="NodeBackground" Property="BorderThickness" Value="4" />
                                                                        <Setter TargetName="NodeBackground" Property="Effect" Value="{StaticResource SelectionGlow}" />
                                                                        <Setter TargetName="CustomShape" Property="Stroke" Value="#007ACC" />
                                                                        <Setter TargetName="CustomShape" Property="StrokeThickness" Value="4" />
                                                                        <Setter TargetName="CustomShape" Property="Effect" Value="{StaticResource SelectionGlow}" />
                                                                    </DataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Thumb.Template>
                                                        <Thumb.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="Xóa node" Click="DeleteNodeMenuItem_OnClick" CommandParameter="{Binding}" />
                                                            </ContextMenu>
                                                        </Thumb.ContextMenu>
                                                    </Thumb>

                                                    <Thumb Tag="TopLeft"  Style="{StaticResource HoverResizeThumbStyle}"   Cursor="SizeNWSE" DragDelta="Thumb_DragDelta" DragStarted="Thumb_DragStarted" Width="10" Height="10" VerticalAlignment="Top" HorizontalAlignment="Left" Background="Transparent" />
                                                    <Thumb Tag="TopRight"  Style="{StaticResource HoverResizeThumbStyle}"  Cursor="SizeNESW" DragDelta="Thumb_DragDelta" DragStarted="Thumb_DragStarted" Width="10" Height="10" VerticalAlignment="Top" HorizontalAlignment="Right" Background="Transparent" />
                                                    <Thumb Tag="BottomLeft" Style="{StaticResource HoverResizeThumbStyle}" Cursor="SizeNESW" DragDelta="Thumb_DragDelta" DragStarted="Thumb_DragStarted" Width="10" Height="10" VerticalAlignment="Bottom" HorizontalAlignment="Left" Background="Transparent" />
                                                    <Thumb Tag="BottomRight" Style="{StaticResource HoverResizeThumbStyle}" Cursor="SizeNWSE" DragDelta="Thumb_DragDelta" DragStarted="Thumb_DragStarted" Width="10" Height="10" VerticalAlignment="Bottom" HorizontalAlignment="Right" Background="Transparent" />
                                                    <Thumb Tag="Top"  Style="{StaticResource HoverResizeThumbStyle}"  Cursor="SizeNS" DragDelta="Thumb_DragDelta" DragStarted="Thumb_DragStarted" Height="5" VerticalAlignment="Top" Margin="10,0" Background="Transparent" />
                                                    <Thumb Tag="Bottom" Style="{StaticResource HoverResizeThumbStyle}" Cursor="SizeNS" DragDelta="Thumb_DragDelta" DragStarted="Thumb_DragStarted" Height="5" VerticalAlignment="Bottom" Margin="10,0" Background="Transparent" />
                                                    <Thumb Tag="Left"  Style="{StaticResource HoverResizeThumbStyle}" Cursor="SizeWE" DragDelta="Thumb_DragDelta" DragStarted="Thumb_DragStarted" Width="5" HorizontalAlignment="Left" Margin="0,10" Background="Transparent" />
                                                    <Thumb Tag="Right" Style="{StaticResource HoverResizeThumbStyle}" Cursor="SizeWE" DragDelta="Thumb_DragDelta" DragStarted="Thumb_DragStarted" Width="5" HorizontalAlignment="Right" Margin="0,10" Background="Transparent" />

                                                    <Button Command="{Binding ToggleExpandCommand}"
                                                            PreviewMouseLeftButtonDown="ExpandButton_PreviewMouseLeftButtonDown"
                                                            Width="24" Height="24"
                                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                            Margin="0,0,-12,-12" 
                                                            Panel.ZIndex="999"
                                                            Cursor="Hand">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="White" BorderBrush="#007ACC" BorderThickness="1.5" CornerRadius="12">
                                                                                <Border.Effect>
                                                                                    <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.3"/>
                                                                                </Border.Effect>
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasChildren}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>

                                                        <TextBlock FontWeight="ExtraBold" Foreground="#007ACC" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,2">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="+"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                            <Setter Property="Text" Value="-"/>
                                                                            <Setter Property="Margin" Value="0,0,0,0"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="2" Width="320" Background="{DynamicResource SurfaceBrush}" CornerRadius="26,0,0,26" Padding="20" PreviewMouseLeftButtonDown="OnFormattingPanelPreviewMouseLeftButtonDown"
                            Visibility="{Binding IsPresentationMode, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Định dạng" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,20"/>
                                <StackPanel Visibility="{Binding SelectedNode, Converter={StaticResource NullToVisibilityConverter}}">
                                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="15" Margin="0,0,0,15">
                                        <StackPanel>
                                            <TextBlock Text="HÌNH DÁNG và MÀU SẮC" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>
                                            <TextBlock Text="Kiểu dáng" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding ShapeOptions}" SelectedItem="{Binding SelectedNode.Shape}" Height="Auto" Style="{StaticResource ThemedComboBox}" ItemTemplate="{StaticResource ShapeIconTemplate}">
                                                <ComboBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Width="160" IsItemsHost="True" Background="{DynamicResource BackgroundBrush}" />
                                                    </ItemsPanelTemplate>
                                                </ComboBox.ItemsPanel>
                                            </ComboBox>
                                            <TextBlock Text="Màu nền" Foreground="{DynamicResource TextBrush}" Margin="0,15,0,8"/>
                                            <xctk:ColorPicker SelectedColor="{Binding SelectedNode.BackgroundColor, UpdateSourceTrigger=PropertyChanged}" DisplayColorAndName="True" ShowRecentColors="True" ShowDropDownButton="False" Height="40" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" />

                                            <TextBlock Text="Kiểu lưới nền" Foreground="{DynamicResource TextBrush}" Margin="0,15,0,4"/>
                                            <ComboBox Height="30" Style="{StaticResource ThemedComboBox}" SelectedValue="{Binding SelectedNode.BackgroundGridStyle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag">
                                                <ComboBoxItem Content="Không lưới" Tag="None" />
                                                <ComboBoxItem Content="Lưới thưa" Tag="Light" />
                                                <ComboBoxItem Content="Lưới dày" Tag="Dense" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Visibility="{Binding SelectedConnection, Converter={StaticResource NullToVisibilityConverter}}">
                                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="15">
                                        <StackPanel>
                                            <TextBlock Text="THUỘC TÍNH LIÊN KẾT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>

                                            <TextBlock Text="Màu dây" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                                            <xctk:ColorPicker SelectedColor="{Binding SelectedConnection.StrokeColor, UpdateSourceTrigger=PropertyChanged}" DisplayColorAndName="True" ShowRecentColors="True" ShowDropDownButton="False" Height="40" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"/>

                                            <TextBlock Text="Độ dày dây" Foreground="{DynamicResource TextBrush}" Margin="0,15,0,4"/>
                                            <Slider Minimum="1" Maximum="10" Value="{Binding SelectedConnection.Thickness, UpdateSourceTrigger=PropertyChanged}" AutoToolTipPlacement="TopLeft" Margin="0,0,0,10"/>

                                            <TextBlock Text="Hình dáng dây" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                                            <ComboBox SelectedValue="{Binding SelectedConnection.ConnectionStyle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                      Height="26" Style="{StaticResource ThemedComboBox}" 
                      SelectedValuePath="Tag" Margin="0,0,0,8">
                                                <ComboBoxItem Content="Dây cong mềm (Bezier)" Tag="Bezier" />
                                                <ComboBoxItem Content="Dây thẳng (Straight)" Tag="Straight" />
                                            </ComboBox>

                                            <TextBlock Text="Kiểu nét" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                                            <ComboBox SelectedValue="{Binding SelectedConnection.LineStyle, Mode=TwoWay}" Height="26" Style="{StaticResource ThemedComboBox}" SelectedValuePath="Tag" Margin="0,0,0,8">
                                                <ComboBoxItem Content="Nét liền" Tag="Solid" />
                                                <ComboBoxItem Content="Nét đứt" Tag="Dashed" />
                                            </ComboBox>

                                            <TextBlock Text="Mũi tên" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                                            <ComboBox SelectedValue="{Binding SelectedConnection.ArrowStyle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="26" Style="{StaticResource ThemedComboBox}" SelectedValuePath="Tag" Margin="0,0,0,12">
                                                <ComboBoxItem Content="Không mũi tên" Tag="None" />
                                                <ComboBoxItem Content="Có mũi tên" Tag="Arrow" />
                                            </ComboBox>

                                            <Button Content="Xóa liên kết này" Command="{Binding DeleteConnectionCommand}" Background="#333" Foreground="#FF5555" BorderThickness="0" Padding="10" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="#444" BorderThickness="1">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Visibility="{Binding IsCanvasSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="15">
                                        <StackPanel>
                                            <TextBlock Text="ĐỊNH DẠNG CANVAS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>

                                            <TextBlock Text="Màu nền Canvas" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                                            <xctk:ColorPicker SelectedColor="{Binding CanvasBackgroundColor, UpdateSourceTrigger=PropertyChanged}" DisplayColorAndName="True" ShowRecentColors="True" ShowDropDownButton="False" Height="40" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"/>

                                            <TextBlock Text="Kiểu lưới nền" Foreground="{DynamicResource TextBrush}" Margin="0,15,0,4"/>
                                            <ComboBox Height="30" Style="{StaticResource ThemedComboBox}" SelectedValue="{Binding CanvasGridStyle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag">
                                                <ComboBoxItem Content="Không lưới" Tag="None" />
                                                <ComboBoxItem Content="Lưới thưa" Tag="Light" />
                                                <ComboBoxItem Content="Lưới dày" Tag="Dense" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel HorizontalAlignment="Center" Margin="0,150,0,0" Opacity="0.5">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding SelectedNode}" Value="{x:Null}" />
                                                        <Condition Binding="{Binding SelectedConnection}" Value="{x:Null}" />
                                                        <Condition Binding="{Binding IsCanvasSelected}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="🎨" FontSize="48" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Chỉnh Giao Diện" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,5"/>
                                    <TextBlock Text="Click vào Node, Dây hoặc Canvas để chỉnh sửa." Foreground="#AAAAAA" TextWrapping="Wrap" TextAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <views:ProfileDialog Grid.RowSpan="2" Panel.ZIndex="999"/>
        <Button Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,20,0,0"
        Command="{Binding ExitPresentationCommand}"
        Visibility="{Binding IsPresentationMode, Converter={StaticResource BooleanToVisibilityConverter}}"
        Panel.ZIndex="1000" Cursor="Hand">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="#CC000000" CornerRadius="20" Padding="20,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="❌" Margin="0,0,8,0" Foreground="White"/>
                            <TextBlock Text="Thoát trình chiếu" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>