<Window x:Class="MindmapApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MindmapApp.ViewModels"
        xmlns:conv="clr-namespace:MindmapApp.Converters"
        xmlns:anim="clr-namespace:MindmapApp.ViewModels"
        mc:Ignorable="d"
        Title="MindmapApp"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ResizeMode="CanMinimize"
        Background="{DynamicResource BackgroundBrush}"
        WindowStyle="None"
        UseLayoutRounding="True"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit">
    <!--#region Resources-->
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#007ACC"/>
        <DropShadowEffect x:Key="SelectionGlow" Color="#007ACC" BlurRadius="20" ShadowDepth="0" Opacity="0.8"/>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="22" ShadowDepth="0" Opacity="0.18" />
        <conv:ColorToBrushConverter x:Key="ColorToBrushConverter" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <conv:ConnectionToGeometryConverter x:Key="ConnectionToGeometryConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Storyboard x:Key="HideSidebar">
            <anim:GridLengthAnimation Storyboard.TargetName="LeftColumn" Storyboard.TargetProperty="Width" To="0" Duration="0:0:0.2" />
        </Storyboard>
        <Storyboard x:Key="ShowSidebar">
            <anim:GridLengthAnimation Storyboard.TargetName="LeftColumn" Storyboard.TargetProperty="Width" To="280" Duration="0:0:0.2" />
        </Storyboard>
        <Storyboard x:Key="CollapseRight">
            <anim:GridLengthAnimation Storyboard.TargetName="RightColumn" Storyboard.TargetProperty="Width" To="0" Duration="0:0:0.2" />
        </Storyboard>
        <Storyboard x:Key="ExpandRight">
            <anim:GridLengthAnimation Storyboard.TargetName="RightColumn" Storyboard.TargetProperty="Width" To="320" Duration="0:0:0.2" />
        </Storyboard>


        <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#102033" Offset="0" />
            <GradientStop Color="#0C1828" Offset="1" />
        </LinearGradientBrush>
        
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2" CornerRadius="8" Background="#333333" BorderBrush="#555555" BorderThickness="1" />
                <Path x:Name="Arrow" Grid.Column="1" Fill="#88FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z" Margin="0,2,0,0"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter TargetName="Border" Property="Background" Value="#444444" />
                    <Setter TargetName="Arrow" Property="Fill" Value="White" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        
        
    </Window.Resources>
    <!--#endregion-->
    
    <Grid>
        <Grid.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.15" />
        </Grid.Effect>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--Thanh trên cùng chứa [-] [x] -->
        <DockPanel Grid.Row="0" HorizontalAlignment="Stretch" LastChildFill="False" Background="{DynamicResource PrimaryBrush}" Height="25" Margin="0,0,0,0">
            <Image DockPanel.Dock="Right" Source="/Resources/x.png" PreviewMouseDown="Image_PreviewMouseDown" Cursor="Hand" Margin="10,0,20,0">
                <Image.Style>
                    <Style TargetType="Image">
                        <Setter Property="Width" Value="15"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Width" Value="25"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>
            <Image DockPanel.Dock="Right" Source="/Resources/-.png" PreviewMouseDown="Image_PreviewMouseDown_1" Cursor="Hand" Margin="0,0,15,0">
                <Image.Style>
                    <Style TargetType="Image">
                        <Setter Property="Width" Value="15"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Width" Value="25"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>
        </DockPanel>

        
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="28" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Fill="#FF9AD1FF" Margin="0,0,10,0" />
                            <Ellipse Width="10" Height="10" Fill="#FFFCE38A" Margin="0,0,10,0" />
                            <Ellipse Width="10" Height="10" Fill="#FF89F7FE" />
                        </StackPanel>
                        <TextBlock Foreground="Blue" FontSize="20" FontWeight="Bold" Margin="0,5,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Mind Map App"></Setter>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,5,0,0">
                            <TextBlock Text="Project:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#666"/>
                            <TextBox Width="200" Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="#CCC" Foreground="{DynamicResource TextBrush}" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Margin="10,0,0,0" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">

                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="20" BorderBrush="#DDD" BorderThickness="1" Height="40" Margin="0,0,15,0">
                            <Grid Width="220">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" TextChanged="SearchBox_TextChanged" 
                             Margin="0" Padding="15,0" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0"/>
                                    <TextBlock x:Name="Placeholder" Text="Tìm kiếm node..." Foreground="#FF9AA9BC" Margin="15,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                                </Grid>
                                <Button Grid.Column="1" Content="🔍" Command="{Binding SearchCommand}" Width="40" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="{DynamicResource AccentBrush}"/>
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                            <ToggleButton Style="{StaticResource ToolbarToggle}" ToolTip="Chế độ trình chiếu" IsChecked="{Binding IsPresentationMode}" Command="{Binding TogglePresentationCommand}" Height="40" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📺" Margin="0,0,5,0"/>
                                    <TextBlock Text="Trình chiếu"/>
                                </StackPanel>
                            </ToggleButton>

                            <Button Style="{StaticResource ToolbarButton}" 
                                    Click="BtnExportImage_Click"
                                    Height="40" Margin="0,0,10,0" ToolTip="Xuất ra file ảnh PNG">           
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📷" Margin="0,0,5,0"/>
                                    <TextBlock Text="Ảnh"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource ToolbarButton}" 
                                    Click="BtnExportPdf_Click"
                                    Height="40" Margin="0,0,15,0" ToolTip="Xuất ra file PDF">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📄" Margin="0,0,5,0"/>
                                    <TextBlock Text="PDF"/>
                                </StackPanel>
                            </Button>
                       
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="{DynamicResource BackgroundBrush}" CornerRadius="16" Margin="0,0,0,0" Padding="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                <Border Background="#10000000" CornerRadius="8" Padding="5" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding AddNodeCommand}" Content="➕ Thêm Node" MinWidth="100" FontWeight="SemiBold"/>
                                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding AddChildNodeCommand}" Content="🌱 Nhánh con" MinWidth="100"/>
                                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding DeleteNodeCommand}" Content="❌ Xóa" MinWidth="80" Foreground="#D32F2F"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#10000000" CornerRadius="8" Padding="5" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource ToolbarButton}" Click="StartConnectionButton_OnClick" Content="🔗 Nối dây" MinWidth="90"/>
                                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding ClearConnectionCommand}" Content="✂️ Hủy" MinWidth="70"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#10000000" CornerRadius="8" Padding="5" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding ZoomInCommand}" Content="🔍 +" MinWidth="60" ToolTip="Phóng to"/>
                                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding ZoomOutCommand}" Content="🔍 -" MinWidth="60" ToolTip="Thu nhỏ"/>
                                    </StackPanel>
                                </Border>

                                <Button Style="{StaticResource ToolbarButton}" Command="{Binding ToggleThemeCommand}" Content="🌗 Theme" MinWidth="80" Margin="0,0,5,0"/>
                                <Button Style="{StaticResource ToolbarButton}" Command="{Binding OpenProfileCommand}" Content="👤 Tài khoản" MinWidth="90" Background="#334455" BorderBrush="#556677" Foreground="White"/>
                                <Button Style="{StaticResource ToolbarButton}" Command="{Binding ClearAllCommand}" Content="🗑️ Xóa tất cả" MinWidth="100" Background="#FFEF9A9A" Foreground="#B71C1C" BorderBrush="#FFEF5350" Margin="5,0,0,0"/>

                            </StackPanel>
                        </ScrollViewer>

                        <ToggleButton Grid.Column="1" x:Name="BtnToggleRight" Click="BtnToggleRight_Click" IsChecked="True" Cursor="Hand" Margin="10,0,5,0" Height="35" Background="Transparent" BorderThickness="0" ToolTip="Đóng/Mở Menu Định Dạng">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="#1AFFFFFF" CornerRadius="8" Padding="12,0" BorderBrush="#33FFFFFF" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Định dạng" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock x:Name="ArrowIcon" Text="▶" Foreground="#4DD0E1" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="ArrowIcon" Property="Text" Value="▶" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="False">
                                            <Setter TargetName="ArrowIcon" Property="Text" Value="◀" />
                                            <Setter TargetName="ArrowIcon" Property="Foreground" Value="Gray" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="0,18,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="LeftColumn" Width="280" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="RightColumn" Width="320" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource SidebarGradient}" CornerRadius="26" Padding="22">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Nội dung Node" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="Quản lý node và tài liệu hiện tại" Foreground="#88FFFFFF" Margin="0,4,0,0" />
                                <Border Style="{StaticResource SidebarCardStyle}">
                                    <!-- Tiêu đề và nội dung node-->
                                    <StackPanel>
                                        <TextBlock Text="Chưa có node nào được chọn" Foreground="#88FFFFFF" TextWrapping="Wrap" Margin="0,12,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedNode}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Margin="0,12,0,0">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedNode}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="Tiêu đề" Foreground="{DynamicResource TextBrush}" />
                                            <TextBox Text="{Binding SelectedNode.Title, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="Nội dung" Foreground="{DynamicResource TextBrush}" Margin="0,12,0,0" />
                                            <TextBox Text="{Binding SelectedNode.Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="150" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                    
                                </Border>
                                <Border Style="{StaticResource SidebarCardStyle}">
                                   
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <Button x:Name="ToggleButton" Grid.Column="1" Content="◀" Width="34" Height="120" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-16,0,0,0" Padding="0" Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderThickness="0" FontSize="18" Click="ToggleSidebar_Click" Panel.ZIndex="5">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.35" />
                        </Button.Effect>
                    </Button>
                    <Border Grid.Column="1" Background="{DynamicResource BackgroundBrush}" CornerRadius="26" Padding="0" ClipToBounds="True">
                        <ScrollViewer x:Name="MainScrollViewer" Background="{DynamicResource GridBackgroundBrush}" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible" PanningMode="None">
                            <Grid x:Name="MindmapWorkspace" 
                                  Width="{Binding CanvasWidth}" 
                                  Height="{Binding CanvasHeight}"
                                  Background="{DynamicResource GridBackgroundBrush}" 
                                  MouseDown="MindmapWorkspace_MouseDown" 
                                  MouseMove="MindmapWorkspace_MouseMove" 
                                  MouseUp="MindmapWorkspace_MouseUp">
                                <Grid.LayoutTransform>
                                    <ScaleTransform ScaleX="{Binding ZoomLevel}" ScaleY="{Binding ZoomLevel}" />
                                </Grid.LayoutTransform>
                                <Border BorderBrush="#1A000000" BorderThickness="2" Background="#20FFFFFF" Opacity="1" IsHitTestVisible="False"/>

                                <!-- Dây nối-->
                                <ItemsControl ItemsSource="{Binding Connections}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    
                                   
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ConnectionViewModel}">
                                            <Grid>
                                                <Path StrokeThickness="20" Stroke="White" Opacity="0" Cursor="Hand" MouseLeftButtonDown="Path_MouseLeftButtonDown">
                                                    <Path.Data>
                                                        <MultiBinding Converter="{StaticResource ConnectionToGeometryConverter}">
                                                            <Binding Path="Source.X" />
                                                            <Binding Path="Source.Y" />
                                                            <Binding Path="Source.Width" />
                                                            <Binding Path="Source.Height" />
                                                            <Binding Path="Target.X" />
                                                            <Binding Path="Target.Y" />
                                                            <Binding Path="Target.Width" />
                                                            <Binding Path="Target.Height" />
                                                        </MultiBinding>
                                                    </Path.Data>
                                                </Path>

                                                <Path x:Name="SelectionGlowPath" IsHitTestVisible="False" Stroke="#007ACC" StrokeThickness="6" Opacity="0" StrokeEndLineCap="Round" StrokeStartLineCap="Round">
                                                    <Path.Effect>
                                                        <DropShadowEffect Color="#007ACC" BlurRadius="15" ShadowDepth="0" Opacity="1"/>
                                                    </Path.Effect>
                                                    <Path.Data>
                                                        <MultiBinding Converter="{StaticResource ConnectionToGeometryConverter}">
                                                            <Binding Path="Source.X" />
                                                            <Binding Path="Source.Y" />
                                                            <Binding Path="Source.Width" />
                                                            <Binding Path="Source.Height" />
                                                            <Binding Path="Target.X" />
                                                            <Binding Path="Target.Y" />
                                                            <Binding Path="Target.Width" />
                                                            <Binding Path="Target.Height" />
                                                        </MultiBinding>
                                                    </Path.Data>
                                                </Path>

                                                <Path x:Name="VisualPath" IsHitTestVisible="False" StrokeThickness="{Binding Thickness}" Stroke="{Binding StrokeColor, Converter={StaticResource ColorToBrushConverter}}" Opacity="0.9" StrokeEndLineCap="Round" StrokeStartLineCap="Round">
                                                    <Path.Data>
                                                        <MultiBinding Converter="{StaticResource ConnectionToGeometryConverter}">
                                                            <Binding Path="Source.X" />
                                                            <Binding Path="Source.Y" />
                                                            <Binding Path="Source.Width" />
                                                            <Binding Path="Source.Height" />
                                                            <Binding Path="Target.X" />
                                                            <Binding Path="Target.Y" />
                                                            <Binding Path="Target.Width" />
                                                            <Binding Path="Target.Height" />
                                                        </MultiBinding>
                                                    </Path.Data>
                                                </Path>
                                            </Grid>

                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="SelectionGlowPath" Property="Opacity" Value="1" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                    
                                </ItemsControl>
                                
                                <!--  Node -->
                                <ItemsControl ItemsSource="{Binding Nodes}" Canvas.ZIndex="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        
                                        
                                        <DataTemplate DataType="{x:Type vm:NodeViewModel}">
                                            <Grid Width="{Binding Width}" Height="{Binding Height}">
                                            
                                            <Thumb Width="{Binding Width}" Height="{Binding Height}" 
                                                   Tag="{Binding}" DragDelta="NodeThumb_OnDragDelta" 
                                                   PreviewMouseLeftButtonDown="Thumb_PreviewMouseLeftButtonDown"
                                                   DragStarted="Thumb_DragStarted"
                                                   >
                                                <Thumb.Style>
                                                    <Style TargetType="Thumb">
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDraggable}" Value="False">
                                                                <Setter Property="Cursor" Value="Arrow"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Thumb.Style>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Grid>
                                                            <Grid>
                                                                <Border x:Name="NodeBackground" Background="{Binding BackgroundColor, Converter={StaticResource ColorToBrushConverter}}" CornerRadius="12" BorderThickness="2" BorderBrush="{Binding BorderColor, Converter={StaticResource ColorToBrushConverter}}"></Border>
                                                                <Path x:Name="DiamondShape" Visibility="Collapsed" Stretch="Fill" Data="M 0.5,0 L 1,0.5 L 0.5,1 L 0,0.5 Z" Fill="{Binding BackgroundColor, Converter={StaticResource ColorToBrushConverter}}" Stroke="{Binding BorderColor, Converter={StaticResource ColorToBrushConverter}}" StrokeThickness="2">
                                                                    <Path.Effect>
                                                                        <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.25" />
                                                                    </Path.Effect>
                                                                </Path>
                                                                <TextBlock Text="{Binding Title}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="{Binding FontWeight}" FontSize="{Binding FontSize}" Foreground="{Binding TextColor, Converter={StaticResource ColorToBrushConverter}}" TextWrapping="Wrap"/>
                                                            </Grid>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Shape}" Value="Rectangle">
                                                                <Setter TargetName="NodeBackground" Property="CornerRadius" Value="12" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Shape}" Value="Ellipse">
                                                                <Setter TargetName="NodeBackground" Property="CornerRadius" Value="120" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Shape}" Value="Diamond">
                                                                <Setter TargetName="NodeBackground" Property="Visibility" Value="Collapsed" />
                                                                <Setter TargetName="DiamondShape" Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter TargetName="NodeBackground" Property="BorderBrush" Value="#007ACC" />
                                                                <Setter TargetName="NodeBackground" Property="BorderThickness" Value="4" />
                                                                <Setter TargetName="NodeBackground" Property="Effect" Value="{StaticResource SelectionGlow}" />
                                                                <Setter TargetName="DiamondShape" Property="Stroke" Value="#007ACC" />
                                                                <Setter TargetName="DiamondShape" Property="StrokeThickness" Value="4" />
                                                                <Setter TargetName="DiamondShape" Property="Effect" Value="{StaticResource SelectionGlow}" />
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                                <Thumb.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Xóa node" Click="DeleteNodeMenuItem_OnClick" CommandParameter="{Binding}" />
                                                    </ContextMenu>
                                                </Thumb.ContextMenu>
                                            </Thumb>

                                                <!-- 8 Thumb bọc quanh để hộ trợ thay đổi kích thước !!!-->
                                                <Thumb Tag="TopLeft"  Style="{StaticResource HoverResizeThumbStyle}"   Cursor="SizeNWSE" DragDelta="Thumb_DragDelta"  Width="10" Height="10" VerticalAlignment="Top" HorizontalAlignment="Left" Background="Transparent" />
                                                <Thumb Tag="TopRight"  Style="{StaticResource HoverResizeThumbStyle}"  Cursor="SizeNESW" DragDelta="Thumb_DragDelta"  Width="10" Height="10" VerticalAlignment="Top" HorizontalAlignment="Right" Background="Transparent" />
                                                <Thumb Tag="BottomLeft" Style="{StaticResource HoverResizeThumbStyle}" Cursor="SizeNESW" DragDelta="Thumb_DragDelta"  Width="10" Height="10" VerticalAlignment="Bottom" HorizontalAlignment="Left" Background="Transparent" />
                                                <Thumb Tag="BottomRight" Style="{StaticResource HoverResizeThumbStyle}" Cursor="SizeNWSE" DragDelta="Thumb_DragDelta"  Width="10" Height="10" VerticalAlignment="Bottom" HorizontalAlignment="Right" Background="Transparent" />

                                                <Thumb Tag="Top"  Style="{StaticResource HoverResizeThumbStyle}"  Cursor="SizeNS" DragDelta="Thumb_DragDelta"  Height="5" VerticalAlignment="Top" Margin="10,0" Background="Transparent" />
                                                <Thumb Tag="Bottom" Style="{StaticResource HoverResizeThumbStyle}" Cursor="SizeNS" DragDelta="Thumb_DragDelta"  Height="5" VerticalAlignment="Bottom" Margin="10,0" Background="Transparent" />
                                                <Thumb Tag="Left"  Style="{StaticResource HoverResizeThumbStyle}" Cursor="SizeWE" DragDelta="Thumb_DragDelta"  Width="5" HorizontalAlignment="Left" Margin="0,10" Background="Transparent" />
                                                <Thumb Tag="Right" Style="{StaticResource HoverResizeThumbStyle}" Cursor="SizeWE" DragDelta="Thumb_DragDelta"  Width="5" HorizontalAlignment="Right" Margin="0,10" Background="Transparent" />
                                            </Grid>
                                        </DataTemplate>
                                        
                                        
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                           
                            </Grid>
                            
                        </ScrollViewer>
                    </Border>
                    <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="26,0,0,26" Padding="20">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <!-- Định dạng cho Node và dây -->
                            <StackPanel>
                                <TextBlock Text="Định dạng" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,20"/>
                               
                                <!-- Định dạng cho  Node -->
                                <StackPanel Visibility="{Binding SelectedNode, Converter={StaticResource NullToVisibilityConverter}}">
                                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="15" Margin="0,0,0,15">
                                        <StackPanel>
                                            <TextBlock Text="HÌNH DÁNG và MÀU SẮC" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>

                                            <TextBlock Text="Kiểu dáng" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding ShapeOptions}" SelectedItem="{Binding SelectedNode.Shape}" Height="35" Style="{StaticResource SmallArrowComboBox}" Background="#333"/>

                                            <TextBlock Text="Màu nền" Foreground="{DynamicResource TextBrush}" Margin="0,15,0,8"/>

                                            <xctk:ColorPicker SelectedColor="{Binding SelectedNode.BackgroundColor, UpdateSourceTrigger=PropertyChanged}"
                                                              DisplayColorAndName="True"
                                                              ShowRecentColors="True"
                                                              ShowDropDownButton="False"
                                                              Height="40"
                                                              Background="#333333"
                                                              Foreground="White"
                                                              BorderBrush="#555555">
                                                <xctk:ColorPicker.ButtonStyle>
                                                    <Style TargetType="ToggleButton">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <Border Background="{TemplateBinding Background}" 
                                                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                                                            BorderThickness="1" 
                                                                            CornerRadius="8" 
                                                                            Padding="10,0">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
                                                                            <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#AAAAAA" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </xctk:ColorPicker.ButtonStyle>
                                            </xctk:ColorPicker>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="15">
                                        <StackPanel>
                                            <TextBlock Text="VĂN BẢN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>

                                            <TextBlock Text="Font chữ" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding FontOptions}" SelectedItem="{Binding SelectedNode.FontFamily}" Style="{StaticResource SmallArrowComboBox}" Height="35" Background="#333"/>

                                            <Grid Margin="0,15,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Cỡ chữ" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                                                    <ComboBox ItemsSource="{Binding FontSizeOptions}" SelectedItem="{Binding SelectedNode.FontSize}" Style="{StaticResource SmallArrowComboBox}" Height="35" Background="#333"/>
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Text="Màu chữ" Foreground="{DynamicResource TextBrush}" Margin="0,15,0,8"/>

                                            <xctk:ColorPicker SelectedColor="{Binding SelectedNode.TextColor, UpdateSourceTrigger=PropertyChanged}"
                                                              DisplayColorAndName="True"
                                                              ShowRecentColors="True"
                                                              ShowDropDownButton="False"
                                                              Height="40"
                                                              Background="#333333"
                                                              Foreground="White"
                                                              BorderBrush="#555555">
                                                <xctk:ColorPicker.ButtonStyle>
                                                    <Style TargetType="ToggleButton">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <Border Background="{TemplateBinding Background}" 
                                                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                                                            BorderThickness="1" 
                                                                            CornerRadius="8" 
                                                                            Padding="10,0">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
                                                                            <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#AAAAAA" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </xctk:ColorPicker.ButtonStyle>
                                            </xctk:ColorPicker>

                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Định dạng cho Dây -->
                                <StackPanel Visibility="{Binding SelectedConnection, Converter={StaticResource NullToVisibilityConverter}}">
                                    <Border Background="#2D2D2D" CornerRadius="12" Padding="15">
                                        <StackPanel>
                                            <TextBlock Text="THUỘC TÍNH LIÊN KẾT" FontSize="11" FontWeight="Bold" Foreground="#88FFFFFF" Margin="0,0,0,10"/>

                                            <TextBlock Text="Màu dây" Foreground="#DDDDDD" Margin="0,0,0,8"/>

                                            <xctk:ColorPicker SelectedColor="{Binding SelectedConnection.StrokeColor, UpdateSourceTrigger=PropertyChanged}"
                                                              DisplayColorAndName="True"
                                                              ShowRecentColors="True"
                                                              ShowDropDownButton="False"
                                                              Height="40"
                                                              Background="#333333"
                                                              Foreground="White"
                                                              BorderBrush="#555555">
                                                <xctk:ColorPicker.ButtonStyle>
                                                    <Style TargetType="ToggleButton">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <Border Background="{TemplateBinding Background}" 
                                                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                                                            BorderThickness="1" 
                                                                            CornerRadius="8" 
                                                                            Padding="10,0">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
                                                                            <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#AAAAAA" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </xctk:ColorPicker.ButtonStyle>
                                            </xctk:ColorPicker>

                                            <TextBlock Text="Độ dày dây" Foreground="#DDDDDD" Margin="0,15,0,4"/>
                                            <Slider Minimum="1" Maximum="10" Value="{Binding SelectedConnection.Thickness}" AutoToolTipPlacement="TopLeft" Margin="0,0,0,20"/>

                                            <Button Content="Xóa liên kết này" Command="{Binding DeleteConnectionCommand}" Background="#333" Foreground="#FF5555" BorderThickness="0" Padding="10" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="#444" BorderThickness="1">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel HorizontalAlignment="Center" Margin="0,150,0,0" Opacity="0.5">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding SelectedNode}" Value="{x:Null}" />
                                                        <Condition Binding="{Binding SelectedConnection}" Value="{x:Null}" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="🎨" FontSize="48" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Chỉnh Giao Diện" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,5"/>
                                    <TextBlock Text="Chọn node hoặc dây để chỉnh sửa." Foreground="#AAAAAA" TextWrapping="Wrap" TextAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Cửa sổ tài khoản(đăng xuất, đăng nhập tài khoản khác)-->
        <Grid x:Name="ProfileDialogOverlay"
              Visibility="{Binding IsProfileDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              Panel.ZIndex="999"
              Background="#AA000000" Grid.RowSpan="2">
            <Border Width="450" Height="Auto" 
                    Background="{DynamicResource SurfaceBrush}" 
                    CornerRadius="16" 
                    BorderBrush="{DynamicResource AccentBrush}" 
                    BorderThickness="1"
                    Padding="30"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="10" Color="Black" Opacity="0.5"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Cài đặt tài khoản" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <TextBlock Text="Tên hiển thị" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding EditDisplayName, UpdateSourceTrigger=PropertyChanged}" 
                             Height="35" Padding="10,0" VerticalContentAlignment="Center" 
                             Background="{DynamicResource SurfaceBrush}" 
                             Foreground="{DynamicResource TextBrush}" 
                             BorderBrush="{DynamicResource BorderBrush}"
                             Margin="0,0,0,20">
                        <TextBox.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,20"/>

                    <TextBlock Text="Đổi mật khẩu (Để trống nếu không đổi)" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,15" FontStyle="Italic" Opacity="0.8"/>

                    <TextBlock Text="Mật khẩu hiện tại" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,5"/>

                    <Grid Margin="0,0,0,15">
                        <PasswordBox x:Name="PbCurrentPass" Style="{StaticResource ModernPasswordBox}"/>
                        <TextBox x:Name="VisiblePbCurrentPass" Visibility="Collapsed" Style="{StaticResource ModernTextBoxReveal}"/>
                        <ToggleButton Style="{StaticResource EyeToggleButtonStyle}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"
                                      Checked="ShowCurrentPass_Checked" Unchecked="ShowCurrentPass_Unchecked"/>
                    </Grid>
                    <TextBlock Text="Mật khẩu mới" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,5"/>

                    <Grid Margin="0,0,0,15">
                        <PasswordBox x:Name="PbNewPass" Style="{StaticResource ModernPasswordBox}" ToolTip="Tối thiểu 8 ký tự, 1 hoa, 1 thường, 1 số, 1 ký tự đặc biệt"/>
                        <TextBox x:Name="VisiblePbNewPass" Visibility="Collapsed" Style="{StaticResource ModernTextBoxReveal}"/>
                        <ToggleButton Style="{StaticResource EyeToggleButtonStyle}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"
                                      Checked="ShowNewPass_Checked" Unchecked="ShowNewPass_Unchecked"/>
                    </Grid>
                    <TextBlock Text="Xác nhận mật khẩu mới" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,5"/>

                    <Grid Margin="0,0,0,25">
                        <PasswordBox x:Name="PbConfirmPass" Style="{StaticResource ModernPasswordBox}"/>
                        <TextBox x:Name="VisiblePbConfirmPass" Visibility="Collapsed" Style="{StaticResource ModernTextBoxReveal}"/>
                        <ToggleButton Style="{StaticResource EyeToggleButtonStyle}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"
                                      Checked="ShowConfirmPass_Checked" Unchecked="ShowConfirmPass_Unchecked"/>
                    </Grid>
                    <StackPanel Orientation="Vertical" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,20">
                            <Button Content="Hủy bỏ" 
                                    Command="{Binding CloseProfileCommand}"
                                    Width="100" Height="35" 
                                    Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0"
                                    Cursor="Hand" Margin="0,0,10,0" Opacity="0.7"/>

                            <Button Content="Lưu thay đổi" 
                                    Click="BtnSaveProfile_Click"
                                    Width="120" Height="35" 
                                    Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"
                                    Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>

                        <Button Content="Đăng xuất" 
                                Command="{Binding LogoutCommand}"
                                Height="35" 
                                Background="#FFEF9A9A" Foreground="#FFC62828" BorderThickness="0"
                                Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>