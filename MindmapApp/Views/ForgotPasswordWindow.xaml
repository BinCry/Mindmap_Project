<Window x:Class="MindmapApp.Views.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Khôi phục mật khẩu"
        WindowStartupLocation="CenterOwner"
        Width="520"
        Height="700"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.Effect>
            <DropShadowEffect BlurRadius="28" Opacity="0.22" ShadowDepth="0" />
        </Grid.Effect>

        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="24" Padding="32">
            <ScrollViewer VerticalScrollBarVisibility="Hidden">
                <StackPanel>
                    <TextBlock Text="Quên mật khẩu" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="Nhập email của bạn để nhận OTP" Foreground="{DynamicResource TextBrush}" Opacity="0.7" Margin="0,4,0,20" />

                    <StackPanel Margin="0,0,0,0">
                        <TextBlock Text="Email" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="36" Padding="8" BorderThickness="1"
                                 Background="{DynamicResource BackgroundBrush}"
                                 Foreground="{DynamicResource TextBrush}"
                                 BorderBrush="{DynamicResource TextBrush}"
                                 CaretBrush="{DynamicResource TextBrush}"/>
                    </StackPanel>

                    <Button Content="Gửi OTP" Margin="0,18,0,0" Click="SendOtpButton_OnClick" Height="36"
                            Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderThickness="0"/>

                    <Separator Margin="0,26,0,16" Background="{DynamicResource TextBrush}" Opacity="0.2"/>

                    <TextBlock Text="Nhập mã OTP" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Otp, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" 
                             Height="34" Padding="8" BorderThickness="1"
                             Background="{DynamicResource BackgroundBrush}"
                             Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource TextBrush}"
                             CaretBrush="{DynamicResource TextBrush}"/>

                    <StackPanel Margin="0,16,0,0">
                        <TextBlock Text="Mật khẩu mới" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4" />
                        <Grid Margin="0,8,0,0">
                            <PasswordBox x:Name="NewPasswordBox" 
                                         Style="{StaticResource ModernPasswordBox}"
                                         Height="34" Padding="8,8,35,8" BorderThickness="1"
                                         Background="{DynamicResource BackgroundBrush}"
                                         Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource TextBrush}"
                                         CaretBrush="{DynamicResource TextBrush}"/>

                            <TextBox x:Name="VisibleNewPasswordBox" Visibility="Collapsed"
                                     Style="{StaticResource ModernTextBoxReveal}"
                                     Height="34" Padding="8,8,35,8" BorderThickness="1"
                                     Background="{DynamicResource BackgroundBrush}"
                                     Foreground="{DynamicResource TextBrush}"
                                     BorderBrush="{DynamicResource TextBrush}"
                                     CaretBrush="{DynamicResource TextBrush}"/>

                            <ToggleButton Style="{StaticResource EyeToggleButtonStyle}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"
                                          Checked="ShowNewPassword_Checked" Unchecked="ShowNewPassword_Unchecked"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="Xác nhận mật khẩu" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4" />
                        <Grid Margin="0,8,0,0">
                            <PasswordBox x:Name="ConfirmNewPasswordBox" 
                                         Style="{StaticResource ModernPasswordBox}"
                                         Height="34" Padding="8,8,35,8" BorderThickness="1"
                                         Background="{DynamicResource BackgroundBrush}"
                                         Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource TextBrush}"
                                         CaretBrush="{DynamicResource TextBrush}"/>

                            <TextBox x:Name="VisibleConfirmNewPasswordBox" Visibility="Collapsed"
                                     Style="{StaticResource ModernTextBoxReveal}"
                                     Height="34" Padding="8,8,35,8" BorderThickness="1"
                                     Background="{DynamicResource BackgroundBrush}"
                                     Foreground="{DynamicResource TextBrush}"
                                     BorderBrush="{DynamicResource TextBrush}"
                                     CaretBrush="{DynamicResource TextBrush}"/>

                            <ToggleButton Style="{StaticResource EyeToggleButtonStyle}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"
                                          Checked="ShowConfirmNewPassword_Checked" Unchecked="ShowConfirmNewPassword_Unchecked"/>
                        </Grid>
                    </StackPanel>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFEF5350" Margin="0,16,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="Đã gửi OTP. Vui lòng kiểm tra email của bạn." Foreground="{DynamicResource PrimaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="{Binding IsOtpSent, Converter={StaticResource BoolToVis}}" />

                    <Button Content="Đặt lại mật khẩu" Margin="0,20,0,0" Click="ResetPasswordButton_OnClick" BorderThickness="0" Height="38"
                            Background="{DynamicResource PrimaryBrush}" Foreground="White"/>

                    <Button Content="Đóng" Margin="0,12,0,20" Background="Transparent" Foreground="{DynamicResource PrimaryBrush}" BorderThickness="0" Click="CloseButton_OnClick" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>