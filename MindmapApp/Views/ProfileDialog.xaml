<UserControl x:Class="MindmapApp.Views.ProfileDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid x:Name="ProfileDialogOverlay"
          Visibility="{Binding IsProfileDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
          Background="#AA000000">

        <Border Width="450" Height="Auto" 
                Background="{DynamicResource SurfaceBrush}" 
                CornerRadius="16" 
                BorderBrush="{DynamicResource AccentBrush}" 
                BorderThickness="1" 
                Padding="30" 
                VerticalAlignment="Center" HorizontalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="10" Color="Black" Opacity="0.5"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="Cài đặt tài khoản" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="Tên hiển thị" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,5"/>
                <TextBox Text="{Binding EditDisplayName, UpdateSourceTrigger=PropertyChanged}" Height="35" Padding="10,0" VerticalContentAlignment="Center" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" Margin="0,0,0,20">
                    <TextBox.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,20"/>

                <TextBlock Text="Đổi mật khẩu (Để trống nếu không đổi)" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,15" FontStyle="Italic" Opacity="0.8"/>

                <TextBlock Text="Mật khẩu hiện tại" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,15">
                    <PasswordBox x:Name="PbCurrentPass" Style="{StaticResource ModernPasswordBox}"/>
                    <TextBox x:Name="VisiblePbCurrentPass" Visibility="Collapsed" Style="{StaticResource ModernTextBoxReveal}"/>
                    <ToggleButton Style="{StaticResource EyeToggleButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" Checked="ShowCurrentPass_Checked" Unchecked="ShowCurrentPass_Unchecked"/>
                </Grid>

                <TextBlock Text="Mật khẩu mới" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,15">
                    <PasswordBox x:Name="PbNewPass" Style="{StaticResource ModernPasswordBox}" ToolTip="Tối thiểu 8 ký tự, 1 hoa, 1 thường, 1 số, 1 ký tự đặc biệt"/>
                    <TextBox x:Name="VisiblePbNewPass" Visibility="Collapsed" Style="{StaticResource ModernTextBoxReveal}"/>
                    <ToggleButton Style="{StaticResource EyeToggleButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" Checked="ShowNewPass_Checked" Unchecked="ShowNewPass_Unchecked"/>
                </Grid>

                <TextBlock Text="Xác nhận mật khẩu mới" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,25">
                    <PasswordBox x:Name="PbConfirmPass" Style="{StaticResource ModernPasswordBox}"/>
                    <TextBox x:Name="VisiblePbConfirmPass" Visibility="Collapsed" Style="{StaticResource ModernTextBoxReveal}"/>
                    <ToggleButton Style="{StaticResource EyeToggleButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" Checked="ShowConfirmPass_Checked" Unchecked="ShowConfirmPass_Unchecked"/>
                </Grid>

                <StackPanel Orientation="Vertical" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,20">
                        <Button Content="Hủy bỏ" Command="{Binding CloseProfileCommand}" Width="100" Height="35" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0" Opacity="0.7"/>

                        <Button Content="Lưu thay đổi" Click="BtnSaveProfile_Click"  Width="120" Height="35" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>

                    <Button Content="Đăng xuất" Command="{Binding LogoutCommand}" Height="35" Background="#FFEF9A9A" Foreground="#FFC62828" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>