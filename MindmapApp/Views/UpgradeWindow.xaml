<Window x:Class="MindmapApp.Views.UpgradeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nâng cấp tài khoản Pro" Height="520" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">

	<Window.Resources>
		<Style x:Key="ProButtonStyle" TargetType="Button">
			<Setter Property="Background" Value="#FFA000"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" BorderThickness="0">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="border" Property="Background" Value="#FFC107"/>
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter TargetName="border" Property="Background" Value="#BDC3C7"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Border Grid.Row="0" Background="#FFF8E1" Padding="20,15">
			<StackPanel HorizontalAlignment="Center">
				<TextBlock Text="⭐ NÂNG CẤP PRO ⭐" FontSize="22" FontWeight="Bold" Foreground="#F57F17" HorizontalAlignment="Center"/>
				<TextBlock Text="Mở khóa toàn bộ sức mạnh" FontSize="12" Foreground="#7F8C8D" Margin="0,5,0,0" HorizontalAlignment="Center"/>
			</StackPanel>
		</Border>

		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
			<StackPanel Margin="25,20,25,25">

				<StackPanel Margin="0,0,0,20">
					<TextBlock Text="Quyền lợi đặc biệt:" FontWeight="SemiBold" Margin="0,0,0,8"/>
					<StackPanel Orientation="Horizontal" Margin="0,2">
						<TextBlock Text="✅" Margin="0,0,10,0"/>
						<TextBlock Text="Xuất bản đồ ra PDF chất lượng cao"/>
					</StackPanel>
					<StackPanel Orientation="Horizontal" Margin="0,2">
						<TextBlock Text="✅" Margin="0,0,10,0"/>
						<TextBlock Text="Xuất hình ảnh (PNG/JPG) không vỡ"/>
					</StackPanel>
					<StackPanel Orientation="Horizontal" Margin="0,2">
						<TextBlock Text="✅" Margin="0,0,10,0"/>
						<TextBlock Text="Tạo không giới hạn số lượng Mindmap"/>
					</StackPanel>
				</StackPanel>

				<Separator Margin="0,0,0,20"/>

				<Border Background="White" CornerRadius="12" Padding="15" HorizontalAlignment="Center" Margin="0,0,0,15">
					<Border.Effect>
						<DropShadowEffect Color="Gray" BlurRadius="15" ShadowDepth="2" Opacity="0.2"/>
					</Border.Effect>
					<StackPanel>
						<Image x:Name="QrImage" Width="180" Height="180"/>
						<TextBlock Text="Quét bằng App Ngân hàng" FontSize="11" Foreground="Gray" HorizontalAlignment="Center" Margin="0,5,0,0"/>
					</StackPanel>
				</Border>

				<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
					<TextBlock Text="Chỉ với: " FontSize="14" VerticalAlignment="Bottom" Foreground="#34495E"/>
					<TextBlock Text="10.000 VNĐ" FontSize="24" FontWeight="Bold" Foreground="#E74C3C" VerticalAlignment="Bottom"/>
					<TextBlock Text=" / trọn đời" FontSize="12" VerticalAlignment="Bottom" Foreground="Gray" Margin="0,0,0,4"/>
				</StackPanel>

				<Button x:Name="BtnConfirm" Content="ĐÃ CHUYỂN KHOẢN XONG"
                        Height="45" Style="{StaticResource ProButtonStyle}" Click="BtnConfirm_Click"/>

				<TextBlock x:Name="TxtStatus" Text="" FontSize="13" FontWeight="Medium" Foreground="#E74C3C"
                           HorizontalAlignment="Center" Margin="0,15,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
			</StackPanel>
		</ScrollViewer>

		<Grid x:Name="LoadingGrid" Grid.RowSpan="2" Background="#CCFFFFFF" Visibility="Collapsed">
			<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
				<TextBlock Text="⏳" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10"/>
				<TextBlock Text="Đang kiểm tra giao dịch..." FontWeight="Bold" Foreground="#34495E"/>
			</StackPanel>
		</Grid>
	</Grid>
</Window>