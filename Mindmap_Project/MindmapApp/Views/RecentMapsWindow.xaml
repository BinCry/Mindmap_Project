<Window x:Class="MindmapApp.Views.RecentMapsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MindmapApp.ViewModels"
        xmlns:converters="clr-namespace:MindmapApp.Converters"
        mc:Ignorable="d"
        Title="Recent Mindmaps" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#FF121212" Foreground="White">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- List -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Recents" FontSize="28" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" Height="20" Width="60" BorderThickness="0" Command="{Binding LogoutCommand}" ToolTip="Logout">
                <TextBlock Text="Logout" Foreground="#FFE04B4B" TextDecorations="Underline" Cursor="Hand"/>
            </Button>
        </Grid>

        <!-- Loading Indicator -->
        <Grid Grid.Row="1" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" Panel.ZIndex="10">
            <TextBlock Text="Loading..." Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <!-- Map List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
            <ItemsControl ItemsSource="{Binding RecentMaps}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ItemWidth="220" ItemHeight="180"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:RecentMapItemViewModel}">
                        <Grid Margin="10">
                            <Button BorderThickness="0" Background="Transparent" 
                                    Command="{Binding DataContext.OpenMapCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                    CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CardBorder" Background="#FF1E1E1E" CornerRadius="8" Padding="0">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0">
                                                    <Grid x:Name="NewMapContent" Visibility="Collapsed">
                                                        <TextBlock Text="+" FontSize="60" Foreground="#AAAAAA" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Light"/>
                                                    </Grid>
                                                    <Grid x:Name="MapContent">
                                                        <Border Background="{Binding CanvasBackgroundColor, Converter={StaticResource ColorToBrushConverter}, FallbackValue='#2D2D2D'}" CornerRadius="8,8,0,0" Margin="2"/>
                                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" Opacity="0.65" Margin="8">
                                                            <Image.Effect>
                                                                <BlurEffect Radius="3"/>
                                                            </Image.Effect>
                                                        </Image>
                                                    </Grid>
                                                </Grid>

                                                <StackPanel Grid.Row="1" Margin="10">
                                                    <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock x:Name="DateText" Text="{Binding UpdatedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Foreground="#888888" FontSize="11" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                <Setter TargetName="NewMapContent" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="MapContent" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="DateText" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardBorder" Property="Background" Value="#FF2C2C2C"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-8,0"
                                    Background="#FF4444" BorderThickness="0" Cursor="Hand"
                                    Command="{Binding DataContext.DeleteMapCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="Xóa mindmap này">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="12" BorderBrush="#CC0000" BorderThickness="1">
                                                        <Border.Effect>
                                                            <DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.4"/>
                                                        </Border.Effect>
                                                        <TextBlock Text="X" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Margin="0,0,0,1"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FF6666"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
