<Window x:Class="MindmapApp.Views.PdfExportOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tùy chọn xuất PDF" Height="380" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Border Background="{DynamicResource BackgroundBrush}" 
            CornerRadius="20" 
            BorderBrush="{DynamicResource PrimaryBrush}" 
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="5" Opacity="0.3"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Tùy chọn xuất PDF" FontSize="20" FontWeight="Bold" 
                       Foreground="{DynamicResource PrimaryBrush}" 
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                <TextBlock Text="Mật khẩu bảo vệ (Tùy chọn)" 
                           Foreground="{DynamicResource TextBrush}" Opacity="0.7" Margin="0,0,0,5"/>

                <Grid>
                    <PasswordBox x:Name="TxtPassword" 
                                 PasswordChanged="TxtPassword_PasswordChanged"
                                 Style="{StaticResource ModernPasswordBox}"
                                 Height="45" 
                                 VerticalContentAlignment="Center"
                                 FontSize="16"
                                 FontWeight="Bold"
                                 FontFamily="Verdana"
                                 Background="{DynamicResource SurfaceBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 Foreground="{DynamicResource TextBrush}"
                                 CaretBrush="{DynamicResource TextBrush}"
                                 Padding="5,0,35,0"/>

                    <TextBox x:Name="VisiblePassword"
                             Visibility="Collapsed"
                             TextChanged="VisiblePassword_TextChanged"
                             Style="{StaticResource ModernTextBoxReveal}"
                             Height="45" 
                             VerticalContentAlignment="Center"
                             FontSize="16"
                             FontWeight="Bold"
                             FontFamily="Verdana"
                             Background="{DynamicResource SurfaceBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             Foreground="{DynamicResource TextBrush}"
                             CaretBrush="{DynamicResource TextBrush}"
                             Padding="5,0,35,0"/>

                    <ToggleButton Style="{StaticResource EyeToggleButtonStyle}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" 
                                  Margin="0,0,10,0"
                                  Checked="ShowPassword_Checked" Unchecked="ShowPassword_Unchecked"/>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,0,0,20">
                <Grid Height="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="BarWeak" CornerRadius="3" Margin="0,0,2,0" Grid.Column="0"/>
                    <Border x:Name="BarMedium" CornerRadius="3" Margin="2,0,2,0" Grid.Column="1"/>
                    <Border x:Name="BarStrong" CornerRadius="3" Margin="2,0,0,0" Grid.Column="2"/>
                </Grid>
                <TextBlock x:Name="LblStrength" Text="Chưa nhập mật khẩu" FontSize="11" 
                           Foreground="{DynamicResource TextBrush}" Opacity="0.6"
                           Margin="0,5,0,0" HorizontalAlignment="Right"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,0,0,20">
                <CheckBox x:Name="ChkWatermark" Content="Thêm Watermark bản quyền" 
                          IsChecked="True" FontSize="14" 
                          Foreground="{DynamicResource TextBrush}"
                          VerticalContentAlignment="Center" Cursor="Hand"/>
                <TextBlock Text="(Hiển thị ở góc dưới bên phải)" FontSize="11" 
                           Foreground="{DynamicResource TextBrush}" Opacity="0.5" 
                           Margin="24,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">

                <Button Content="Hủy bỏ" Click="BtnCancel_Click" Width="120" Height="40" Margin ="0,0,20,0"
                        Background="{DynamicResource SurfaceBrush}" 
                        Foreground="{DynamicResource TextBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">
                    <Button.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="20"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="Xuất PDF" Click="BtnExport_Click" Width="120" Height="40"
                        FontWeight="Bold">
                    <Button.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="20"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>